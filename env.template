# =============================================================================
# Travel Life - environment template
# =============================================================================
# (Saved as env.template without the leading dot because a permission rule
# blocks creating .env* files. Rename to .env.template when that is lifted.)
#
# Copy to `.env.production` (docker-compose.prod.yml) or `.env` (TrueNAS files),
# then fill in the REQUIRED section. Everything else is optional: a commented
# line shows the default the application uses when the variable is unset.
#
#   cp env.template .env.production
#   docker-compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Notes
# - Never commit the filled-in file. Treat every value below as a secret unless
#   it is plainly a name, port or URL.
# - docker-compose.prod.yml only forwards the variables it lists. Settings
#   marked [add to compose] work in the backend but are NOT passed through by
#   the bundled compose files yet: add them to the backend `environment:` block
#   first (see DEPLOYMENT.md).
# - The authoritative per-variable documentation is backend/CLAUDE.md.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Database password (the compose file refuses to start without it).
DB_PASSWORD=

# JWT signing secrets. Each must be at least 32 characters and not a well-known
# placeholder, or the backend exits at startup. Generate with:
#   openssl rand -base64 48
# Changing either one signs every user out.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public address of the app, no trailing slash. Used for OIDC callbacks, share
# links, calendar feeds and email links.
BASE_URL=https://travel.example.com
FRONTEND_URL=https://travel.example.com


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DB_USER=travel_life_user
# DB_NAME=travel_life


# -----------------------------------------------------------------------------
# Ports and network exposure
# -----------------------------------------------------------------------------
# FRONTEND_PORT=80
# BACKEND_PORT=5000
# NOMINATIM_PORT=8080

# The API and Nominatim ports are published on loopback only. Set to 0.0.0.0 to
# expose them on the LAN (compose-level setting; not read by the backend).
# INTERNAL_BIND_ADDRESS=127.0.0.1

# Number of reverse proxies in front of the backend (1 = the bundled nginx).
# Use 2 when a TLS proxy or tunnel sits in front of nginx; otherwise every
# visitor shares one rate-limit bucket. Never set higher than the real number.
# TRUST_PROXY=1


# -----------------------------------------------------------------------------
# Sessions, CORS and cookies
# -----------------------------------------------------------------------------
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated extra origins. localhost:3000 and :5173 are allowed by default.
# CORS_ORIGIN=
# strict | lax | none
# COOKIE_SAME_SITE=strict
# e.g. .example.com to share cookies across subdomains
# COOKIE_DOMAIN=


# -----------------------------------------------------------------------------
# Sign-in and registration
# -----------------------------------------------------------------------------
# Close self-service sign-up. Strongly recommended for internet-facing servers.
# Invitations still create accounts.
# DISABLE_REGISTRATION=true

# SSO-only mode. Ignored unless OIDC is configured (lockout guard).
# DISABLE_PASSWORD_LOGIN=false

# OIDC single sign-on (Google, Authentik, Keycloak, Pocket ID, ...). Register
# <BASE_URL>/api/auth/oidc/callback as the redirect URI. PKCE (S256) is always
# used; leave the secret empty for public clients.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# OIDC_SCOPES=openid profile email
# OIDC_BUTTON_TEXT=Sign in with SSO
# OIDC_AUTO_PROVISION=true
# Link to an existing account by email when the IdP omits email_verified.
# Only enable when you fully control the IdP.
# OIDC_TRUST_EMAIL=false


# -----------------------------------------------------------------------------
# Maps, places and routing
# -----------------------------------------------------------------------------
# Self-hosted geocoder (the bundled container).
# NOMINATIM_URL=http://nominatim:8080
# NOMINATIM_PBF_URL=https://download.geofabrik.de/north-america/us-latest.osm.pbf
# NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/north-america/us-updates/

# Accurate road distances (car/bike/walking). Without a key the app falls back
# to straight-line distances.
# OPENROUTESERVICE_API_KEY=
# OPENROUTESERVICE_URL=

# Frontend build-time: CARTO basemap key. Changing it needs a rebuild.
# VITE_CARTO_API_KEY=
# Frontend build-time API/upload paths. Leave the relative defaults alone unless
# the API is served from a different origin.
# VITE_API_URL=/api
# VITE_UPLOAD_URL=/uploads

# Mobile app nearby-food search. [add to compose]
# Comma-separated Overpass servers, tried in order.
# OVERPASS_URL=
# Nominatim-compatible server for "where" lookups (default: public OSM).
# PLACE_SEARCH_URL=
# NEARBY_FOOD_RATE_LIMIT_MAX=30


# -----------------------------------------------------------------------------
# Third-party data sources
# -----------------------------------------------------------------------------
# IMMICH_API_URL=
# IMMICH_API_KEY=
# OPENWEATHERMAP_API_KEY=
# AVIATIONSTACK_API_KEY=

# Currency conversion (Frankfurter needs no key). [add to compose]
# EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1


# -----------------------------------------------------------------------------
# AI features (PDF import, suggestions, journal drafting)
# -----------------------------------------------------------------------------
# AI_ENABLED=true
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=2048
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW_MS=3600000
# AI_LINK_SUGGESTION_MAX_ITEMS=25      # [add to compose]


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Outgoing mail (invitations, notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Saved-link ingest: forward a link to this mailbox and it lands in the inbox.
# Inert unless IMAP_USER and IMAP_PASSWORD are both set. For Gmail use an App
# Password (needs 2-Step Verification), not the account password.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_ARCHIVE_FOLDER=[Gmail]/All Mail
# IMAP_POLL_CRON=*/5 * * * *
# IMAP_MAX_LINKS=20


# -----------------------------------------------------------------------------
# Web push (VAPID). Disabled gracefully when unset.
# Generate keys with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com


# -----------------------------------------------------------------------------
# Scheduled backups [add to compose]
# -----------------------------------------------------------------------------
# Off unless enabled. Writes one JSON backup per user to
# BACKUP_DIR/user-<id>/travel-life-backup-YYYY-MM-DD.json. The files contain
# stored API keys: protect the directory like the database.
# BACKUP_SCHEDULE_ENABLED=false
# BACKUP_DIR=./backups
# BACKUP_CRON=0 3 * * *
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4


# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# UPLOAD_DIR=
# MAX_FILE_SIZE=


# -----------------------------------------------------------------------------
# Rate limits (optional)
# -----------------------------------------------------------------------------
# BACKUP_RATE_LIMIT_MAX=5
# BACKUP_RATE_LIMIT_WINDOW_MS=3600000
# EXTERNAL_API_RATE_LIMIT_MAX=30                 # [add to compose]
# EXTERNAL_API_RATE_LIMIT_WINDOW_MS=3600000      # [add to compose]


# -----------------------------------------------------------------------------
# Security escape hatches. Leave off unless you know why. [add to compose]
# -----------------------------------------------------------------------------
# Let Immich/LLM/SMTP URLs point at private-network addresses (SSRF guard off).
# Always allowed when NODE_ENV=development.
# ALLOW_PRIVATE_INTEGRATION_URLS=false
# Accept old backup files that have no HMAC signature. Restore once, re-export,
# then unset.
# ALLOW_UNSIGNED_BACKUP_RESTORE=false
