  @@index([passportCountry])
  @@index([destinationCountry])
  @@map("visa_requirements")
}

// =============================================================================
// EMERGENCY CARD
// =============================================================================
// The user-entered half of the printable emergency card. The other half — local
// emergency numbers, plug types, tipping — is a static bundled dataset on the
// client (frontend/src/constants/countryFacts.ts) so the card renders with no
// network at all.
//
// Embassy details are entered by the traveller on purpose. A global embassy
// directory is ~200 sending countries x ~200 host countries of addresses that go
// stale constantly; bundling one offline is not feasible, and a wrong embassy
// address on an emergency card is worse than a blank field.

model TripEmergencyInfo {
  id     Int @id @default(autoincrement())
  tripId Int @unique @map("trip_id")

  insuranceProvider        String? @map("insurance_provider") @db.VarChar(255)
  insurancePolicyNumber    String? @map("insurance_policy_number") @db.VarChar(100)
  insuranceAssistancePhone String? @map("insurance_assistance_phone") @db.VarChar(50)

  embassyName    String? @map("embassy_name") @db.VarChar(255)
  embassyPhone   String? @map("embassy_phone") @db.VarChar(50)
  embassyAddress String? @map("embassy_address") @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_emergency_info")
}

// =============================================================================
// TRIP LANGUAGE SYSTEM
// =============================================================================
// Manual language selection per trip for phrase lookup

model TripLanguage {
  id           Int    @id @default(autoincrement())
  tripId       Int    @map("trip_id")
  languageCode String @map("language_code") @db.VarChar(10)
  language     String @db.VarChar(100)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, languageCode])
  @@index([tripId])
  @@map("trip_languages")
}

// =============================================================================
// LANGUAGE PHRASE BANK
