  pronunciation String? @db.Text
  notes         String? @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([languageCode])
  @@index([category])
  @@index([languageCode, category])
  @@map("language_phrases")
}

model PdfImport {
  id            Int             @id @default(autoincrement())
  userId        Int             @map("user_id")
  originalName  String          @map("original_name") @db.VarChar(500)
  storedPath    String          @map("stored_path") @db.VarChar(500)
  fileSizeBytes Int             @map("file_size_bytes")
  status        PdfImportStatus @default(UPLOADED)
  errorMessage  String?         @map("error_message") @db.Text
  processedAt   DateTime?       @map("processed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingEntities PendingEntity[]

  @@index([userId])
  @@index([userId, status])
  @@map("pdf_imports")
}

model PendingEntity {
  id                Int                 @id @default(autoincrement())
  pdfImportId       Int                 @map("pdf_import_id")
  userId            Int                 @map("user_id")
  entityType        PendingEntityType   @map("entity_type")
  parsedData        Json                @map("parsed_data")
  confidence        Float               @default(0.8)
  matchedTripId     Int?                @map("matched_trip_id")
  status            PendingEntityStatus @default(PENDING)
  createdEntityId   Int?                @map("created_entity_id")
  createdEntityType PendingEntityType?  @map("created_entity_type")
  reviewedAt        DateTime?           @map("reviewed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  pdfImport   PdfImport @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchedTrip Trip?     @relation(fields: [matchedTripId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([pdfImportId])
  @@index([matchedTripId])
  @@map("pending_entities")
}

// =============================================================================
// USER INVITATION SYSTEM
// =============================================================================
// Allows users to invite others to join the Travel Life application via email

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model UserInvitation {
  id              Int                  @id @default(autoincrement())
  invitedByUserId Int?                 @map("invited_by_user_id") // NULL for system invites
  email           String               @db.VarChar(255)
  token           String               @unique @db.VarChar(255) // Unique token for accepting invitation
  status          UserInvitationStatus @default(PENDING)
  message         String?              @db.Text // Optional personal message from inviter
  expiresAt       DateTime             @map("expires_at")
  respondedAt     DateTime?            @map("responded_at")
  acceptedUserId  Int?                 @map("accepted_user_id") // ID of user who accepted (after registration)
  createdAt       DateTime             @default(now()) @map("created_at")

  invitedBy    User? @relation("UserInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedUser User? @relation("UserInvitationsAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([invitedByUserId])
  @@index([email, status]) // Composite index for common email+status queries
  @@map("user_invitations")
}

// =============================================================================
// TRAVEL PARTNER REQUEST SYSTEM
// =============================================================================
// A travel partnership makes every new trip either user creates auto-shared with
// the other (see trip.service.ts). That is a real grant of access, so it must be
// consented to by BOTH sides -- `User.travelPartnerId` is only ever written for
// the user making the request themselves, and the reciprocal write happens only
// when the recipient accepts a request here. Modelled on TripInvitation /
// UserInvitation, but addressed by user id rather than email + token: the
// recipient is always an existing account and responds from inside the app, so
// there is no emailed accept-link and therefore no token or expiry.

enum TravelPartnerRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model TravelPartnerRequest {
  id                 Int                        @id @default(autoincrement())
  requesterId        Int                        @map("requester_id")
  recipientId        Int                        @map("recipient_id")
  status             TravelPartnerRequestStatus @default(PENDING)
  message            String?                    @db.Text // Optional personal note from the requester
  // The REQUESTER's opt-in to back-sharing their OWN existing trips with the
  // recipient if the request is accepted. Recorded here because the choice is made
  // at send time but only acted on at accept time. The recipient's equivalent choice
  // is passed on the accept call and never stored — it is acted on immediately.
  // Neither flag can grant anyone access to the other side's history.
  shareExistingTrips Boolean                    @default(false) @map("share_existing_trips")
  respondedAt        DateTime?                  @map("responded_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  requester User @relation("TravelPartnerRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("TravelPartnerRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  // One row per ordered (requester, recipient) pair. This is what makes a
  // re-send idempotent: there can never be two pending requests between the same
  // two users in the same direction, and a request that was declined earlier is
  // revived in place rather than piling up duplicate history rows.
  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
  @@map("travel_partner_requests")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// SAVED LINKS
// =============================================================================
// Reference URLs (restaurant writeups, trail guides, timetables) kept alongside
// a trip. Distinct from the `bookingUrl` fields on Activity/Transportation/
// Lodging, which mean "the booking" rather than "a reference".

enum SavedLinkSource {
  MANUAL
  EMAIL
}

enum LinkMetadataStatus {
  PENDING
  FETCHED
  FAILED
  SKIPPED
}

model SavedLink {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  // Nullable by design: a link exists in the inbox before it belongs to a trip.
  tripId Int? @map("trip_id")

  // Text rather than VarChar(500): real URLs with tracking params exceed 500 chars.
  url         String  @db.Text
  title       String? @db.VarChar(1000)
  description String? @db.Text
  siteName    String? @map("site_name") @db.VarChar(255)
  imageUrl    String? @map("image_url") @db.Text
  notes       String? @db.Text

  source            SavedLinkSource    @default(MANUAL)
  metadataStatus    LinkMetadataStatus @default(PENDING) @map("metadata_status")
  metadataFetchedAt DateTime?          @map("metadata_fetched_at")

  // Provenance for links captured from a forwarded email.
  emailIngestId Int? @map("email_ingest_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a trip returns its links to the inbox
  // rather than destroying them.
  trip        Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  // SetNull so pruning ingest history never destroys the links it produced.
  emailIngest EmailIngest? @relation(fields: [emailIngestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, tripId])
  @@index([tripId])
  @@index([emailIngestId])
  @@map("saved_links")
}

// =============================================================================
// EMAIL INGEST
// =============================================================================
// Polls a dedicated IMAP mailbox and turns forwarded messages into SavedLinks.
// Deterministic: extracts hrefs and scrapes Open Graph tags. No LLM involved —
// unlike the email-import system removed in v5.4.0, which failed on LLM parsing
// of booking emails into structured entities.

enum EmailIngestStatus {
  PROCESSING // Claimed and mid-flight
  PROCESSED // Links created
  NO_LINKS // Nothing usable survived filtering
  REJECTED_SENDER // From address not recognised
  FAILED // Parse or transport error
}

model EmailIngest {
  id        Int    @id @default(autoincrement())
  // The RFC 5322 Message-ID. Unique, and doubles as the processing claim:
  // a re-delivered message is recognised and archived rather than reprocessed.
  messageId String @unique @map("message_id") @db.VarChar(1000)
  // Nullable: a REJECTED_SENDER message belongs to no user.
  userId    Int?   @map("user_id")

  fromAddress String?   @map("from_address") @db.VarChar(500)
  // Captured for plus-address routing later (travellifecc+trip@...), which is
  // otherwise a schema migration rather than a parsing change.
  toAddress   String?   @map("to_address") @db.VarChar(500)
  subject     String?   @db.VarChar(1000)
  receivedAt  DateTime? @map("received_at")

  status       EmailIngestStatus @default(PROCESSING)
  linkCount    Int               @default(0) @map("link_count")
  errorMessage String?           @map("error_message") @db.Text
  processedAt  DateTime?         @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedLinks SavedLink[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@map("email_ingests")
}
