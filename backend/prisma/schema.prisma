// =============================================================================
// Booking deadlines
// =============================================================================
// Cancellation cutoffs, check-in windows and payment due dates attached to a
// lodging, transportation or activity record. Exactly one of the three FKs is
// set; that is enforced by a DB CHECK (booking_deadlines_one_target) added in
// migration 20260810000000_add_booking_deadlines, which Prisma cannot represent.
model BookingDeadline {
  id               Int       @id @default(autoincrement())
  tripId           Int       @map("trip_id")
  lodgingId        Int?      @map("lodging_id")
  transportationId Int?      @map("transportation_id")
  activityId       Int?      @map("activity_id")
  kind             String    @db.VarChar(30) // cancellation, check_in, payment, other
  dueAt            DateTime  @map("due_at")
  note             String?   @db.VarChar(500)
  dismissedAt      DateTime? @map("dismissed_at")
  notifiedAt       DateTime? @map("notified_at") // set once the push reminder has been sent
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lodging        Lodging?        @relation(fields: [lodgingId], references: [id], onDelete: Cascade)
  transportation Transportation? @relation(fields: [transportationId], references: [id], onDelete: Cascade)
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([dueAt])
  @@index([lodgingId])
  @@index([transportationId])
  @@index([activityId])
  @@map("booking_deadlines")
}

// =============================================================================
// Currency conversion
// =============================================================================
// Costed records (TripExpense.amount, Activity/Transportation/Lodging.cost)
// carry an FX snapshot: `exchangeRate` is the rate that was in effect on the
// record's own date, `baseAmount` is amount * exchangeRate, and `baseCurrency`
// names the currency `baseAmount` is expressed in. The snapshot is taken once
// and then FROZEN — it is never recomputed from today's rates, so a past trip's
// reported total does not drift. `baseCurrency` is stored per row precisely so
// that changing the user's home currency invalidates the snapshot (mismatch)
// instead of silently reinterpreting it. All three are null when no rate could
// be obtained; such rows are reported as unconverted rather than being summed
// at face value.

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  date         DateTime @db.Date // Rate date requested (the cache key, not necessarily the quote date)
  fromCurrency String   @map("from_currency") @db.VarChar(3)
  toCurrency   String   @map("to_currency") @db.VarChar(3)
  rate         Decimal  @db.Decimal(20, 10) // toCurrency units per 1 fromCurrency
  source       String   @default("frankfurter") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([date, fromCurrency, toCurrency], name: "exchange_rate_date_pair_unique")
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model JournalEntry {
  id           Int       @id @default(autoincrement())
  tripId       Int       @map("trip_id")
  date         DateTime? @db.Date // NULL for trip-level journals
  title        String?   @db.VarChar(500)
  content      String    @db.Text
  entryType    String    @map("entry_type") @db.VarChar(50) // trip, daily
  mood         String?   @db.VarChar(50)
  weatherNotes String?   @map("weather_notes") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
  @@map("journal_entries")
}

model WeatherData {
  id              Int       @id @default(autoincrement())
  tripId          Int       @map("trip_id")
  locationId      Int?      @map("location_id")
  date            DateTime  @db.Date
  temperatureHigh Decimal?  @map("temperature_high") @db.Decimal(5, 2)
  temperatureLow  Decimal?  @map("temperature_low") @db.Decimal(5, 2)
  conditions      String?   @db.VarChar(255)
  precipitation   Decimal?  @db.Decimal(5, 2)
  humidity        Int?
  windSpeed       Decimal?  @map("wind_speed") @db.Decimal(5, 2)
  sunrise         DateTime?
  sunset          DateTime?
  fetchedAt       DateTime  @default(now()) @map("fetched_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // One cached weather row per trip-day. `locationId` is deliberately NOT part of the
  // key: it is a mutable attribute of the cached row (the day's representative location
  // can change between refreshes and the service overwrites it in place), so including
  // it would let a location change re-introduce duplicate rows for the same day.
  @@unique([tripId, date])
  @@index([tripId])
  @@index([locationId])
  @@map("weather_data")
}

